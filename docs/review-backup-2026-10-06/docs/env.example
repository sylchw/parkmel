# Supabase configuration
# Project URL from Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=

# Project anon (public) key - safe for client-side use
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key - SERVER ONLY, never expose to client
SUPABASE_SERVICE_ROLE_KEY=

# Database URL for direct connection (used in tests and migrations)
DATABASE_URL=

# Map provider configuration
# MapTiler API key for tile and geocoding services
NEXT_PUBLIC_MAPTILER_API_KEY=

# Feature flags
# Enable/disable free parking recommendations
FEATURE_FREE_RECOMMENDATIONS=true

# Enable/disable community submissions
FEATURE_SUBMISSIONS=true

# Enable/disable reward points (dormant in prototype)
FEATURE_REWARDS=false

# Guest allowance configuration (seconds)
GUEST_ALLOWANCE_SECONDS=120

# Guest allowance reset period (days)
GUEST_RESET_DAYS=30