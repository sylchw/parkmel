# Supabase configuration
# Project URL from Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=

# Public publishable key from Supabase Settings > API Keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy anon key fallback; unnecessary when publishable key is configured
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional legacy guest-preview service role key - SERVER ONLY, never expose to client
# Signed-in Carnegie map, drafts, submissions and admin review do not need this key
SUPABASE_SERVICE_ROLE_KEY=

# Optional operator migration connection. The test runner uses its isolated local container.
DATABASE_URL=

# Map provider configuration
# Optional public MapTiler key for operator-configured live tiles (no geocoder wiring)
NEXT_PUBLIC_MAPTILER_API_KEY=

# Legacy prototype flags (not gates for the connected signed-in Carnegie pilot)
# Enable/disable free parking recommendations
FEATURE_FREE_RECOMMENDATIONS=false

# Enable/disable community submissions
FEATURE_SUBMISSIONS=false

# Enable/disable reward points (dormant in prototype)
FEATURE_REWARDS=false

# Guest allowance configuration (seconds)
GUEST_ALLOWANCE_SECONDS=120

# Guest allowance reset period (days)
GUEST_RESET_DAYS=30

# Q18: default offline schematic mode makes no tile/style requests.
NEXT_PUBLIC_MAP_MODE=schematic
NEXT_PUBLIC_MAP_PROVIDER_ENABLED=false
# Supply an approved OSM-based HTTPS style and plain-text provider credit for live mode.
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_PROVIDER_CREDIT=
# Confirm licence/free-plan eligibility and quota stop externally before enabling.
NEXT_PUBLIC_MAP_FREE_PLAN_CONFIRMED=false

# Server-only signing secret, at least 32 bytes; never use NEXT_PUBLIC_ prefix
GUEST_SIGNING_SECRET=

# Optional server-only labelled synthetic destination search; leave blank for real coverage
PARKMEL_SEARCH_FIXTURE=
